<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EReader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
    </style>

    <!-- E-ink screens don't animate: pages and screens just appear. -->
    <style name="Theme.EReader.Reader">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
</resources>
