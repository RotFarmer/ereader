<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checking for and downloading app updates from GitHub. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a downloaded update over the current version. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.EReader">

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <!-- Sketchbook copies (.sketchbook) sent from another device. -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.EReader.Reader"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode" />

        <activity
            android:name=".sketch.SketchActivity"
            android:exported="false"
            android:theme="@style/Theme.EReader.Reader"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode" />

        <!-- Hands sketchbook copies, page pictures and PDFs to the share sheet. -->
        <provider
            android:name=".sketch.SharedFiles"
            android:authorities="com.rotfarmer.ereader.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
